# GEMINI_API_KEY : optionnelle. Sans elle, les conseils restent locaux.
# Crée un fichier .env.local (non versionné) avec les mêmes noms.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL : utile en déploiement (Cloud Run / hébergeur).
APP_URL="http://localhost:3000"
